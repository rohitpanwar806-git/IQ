rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    // User profile collection
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // User scores subcollection
    match /users/{userId}/scores/{gameId} {
      allow read: if isAuth();
      allow write: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // Global scores collection (for backup/analytics)
    match /scores/{userId}/games/{gameId} {
      allow read: if isAuth();
      allow write: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // Global leaderboards (publicly readable, no writes)
    match /leaderboards/{gameId} {
      allow read: if true;  // Anyone can view leaderboards
      allow write: if false; // Leaderboards are computed server-side
      
      // Leaderboard entries subcollection
      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }
    
    // Game settings (publicly readable, admin only for writes)
    match /gameSettings/{gameId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }
    
    // User analytics (private)
    match /analytics/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // Push notification tokens (private)
    match /users/{userId}/notificationTokens/{tokenId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // Catch-all deny rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
